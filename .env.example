# Copy to .env for local runs. In GitHub, add these as repository secrets instead.
# Every key is optional; the pipeline skips or falls back gracefully.

# SEC EDGAR requires a contact email in the User-Agent (fair-access policy). Free.
SEC_CONTACT_EMAIL=

# Google Gemini free tier: https://aistudio.google.com/apikey  (unset = template writer)
GEMINI_API_KEY=
# GEMINI_MODEL=            # optional pin; otherwise the newest Flash model is auto-selected

# Octopart via Nexar: https://portal.nexar.com  (Evaluation app = small lifetime part allowance)
NEXAR_CLIENT_ID=
NEXAR_CLIENT_SECRET=
NEXAR_MONTHLY_PART_BUDGET=40

# Free fallbacks for lead time / stock / price
MOUSER_API_KEY=            # https://www.mouser.com/api-search/
DIGIKEY_CLIENT_ID=         # https://developer.digikey.com
DIGIKEY_CLIENT_SECRET=

SUBSTRATE_CUSTOMER=Demo Distributor
SUBSTRATE_PEERS=ARW,AVT    # peer tickers for competitive inventory tracking
PART_REFRESH_DAYS=3
