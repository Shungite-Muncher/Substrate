{
  "manifest_version": 3,
  "name": "Substrate Part Lookup",
  "version": "0.1.0",
  "description": "Instant supply risk, price trend and lead time for any semiconductor part number.",
  "action": { "default_popup": "popup.html", "default_title": "Substrate lookup" },
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "https://*.github.io/*",
    "https://*.workers.dev/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
